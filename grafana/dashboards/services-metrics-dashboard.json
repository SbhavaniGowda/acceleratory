{
  "uid": "ai-ops-002",
  "title": "AI Service Operational Metrics",
  "schemaVersion": 38,
  "version": 2,
  "editable": true,
  "style": "dark",
  "time": {
    "from": "now-30m",
    "to": "now"
  },
  "tags": ["ai", "services", "k8s", "sre"],
  "annotations": { "list": [] },
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Total Prediction Requests (RPM)",
      "description": "Incoming AI prediction traffic measured as requests per minute.",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS_DS" },
      "targets": [
        {
          "expr": "rate(ai_prediction_requests_total[1m]) * 60",
          "legendFormat": "Requests per Minute",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "all",
          "sort": "desc"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqpm",
          "links": [
            {
              "title": "View request logs",
              "url": "/explore?orgId=1&left={\"datasource\":\"Loki\",\"queries\":[{\"expr\":\"{app=\\\"ai-service\\\"} |= \\\"predict\\\"\"}],\"range\":{\"from\":\"now-30m\",\"to\":\"now\"}}",
              "targetBlank": true
            }
          ]
        }
      }
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "99th Percentile Inference Latency (P99)",
      "description": "Worst-case latency experienced by 99% of requests. Critical for user experience.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS_DS" },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(ai_inference_processing_seconds_bucket[5m])) by (le))",
          "legendFormat": "P99 Latency",
          "refId": "A"
        }
      ],
      "options": {
        "tooltip": {
          "mode": "single"
        }
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "links": [
            {
              "title": "Inspect slow inference logs",
              "url": "/explore?orgId=1&left={\"datasource\":\"Loki\",\"queries\":[{\"expr\":\"{app=\\\"ai-service\\\"} |= \\\"latency\\\"\"}],\"range\":{\"from\":\"now-30m\",\"to\":\"now\"}}",
              "targetBlank": true
            }
          ]
        }
      }
    },
    {
      "id": 3,
      "type": "gauge",
      "title": "System Saturation (GPU Utilization & Temperature)",
      "description": "Real-time hardware saturation indicators to detect overload or overheating risks.",
      "gridPos": { "h": 6, "w": 24, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "PROMETHEUS_DS" },
      "targets": [
        {
          "expr": "ai_accelerator_gpu_utilization",
          "legendFormat": "GPU Utilization (%)",
          "refId": "A"
        },
        {
          "expr": "ai_accelerator_temperature_celsius",
          "legendFormat": "GPU Temperature (°C)",
          "refId": "B"
        }
      ],
      "options": {
        "reduceOptions": {
          "calcs": ["lastNotNull"],
          "fields": "",
          "values": false
        },
        "orientation": "horizontal"
      },
      "fieldConfig": {
        "defaults": {
          "min": 0,
          "max": 100,
          "links": [
            {
              "title": "View GPU-related logs",
              "url": "/explore?orgId=1&left={\"datasource\":\"Loki\",\"queries\":[{\"expr\":\"{app=\\\"ai-service\\\"} |= \\\"gpu\\\"\"}],\"range\":{\"from\":\"now-30m\",\"to\":\"now\"}}",
              "targetBlank": true
            }
          ]
        },
        "overrides": [
          {
            "matcher": { "id": "byName", "options": "GPU Temperature (°C)" },
            "properties": [
              { "id": "max", "value": 120 },
              { "id": "unit", "value": "celsius" }
            ]
          }
        ]
      }
    }
  ],
  "templating": { "list": [] }
}
